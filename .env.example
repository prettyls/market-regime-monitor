DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@ALLOYDB_PRIVATE_IP:5432/regime?schema=public&sslmode=require"
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
SCHWAB_MARKET_CLIENT_ID=YOUR_DEVELOPER_CLIENT_ID
SCHWAB_MARKET_CLIENT_SECRET=YOUR_DEVELOPER_CLIENT_SECRETS
SCHWAB_MARKET_ACCESS_TOKEN=YOUR_SCHWAB_ACCESS_TOKEN
SCHWAB_MARKET_REFRESH_TOKEN=YOUR_SCHWAB_REFRESH_TOKEN
# Must exactly match the Callback URL on this app in the Schwab Developer Portal. Do not use http://localhost unless that exact value is registered there.
SCHWAB_MARKET_REDIRECT_URI=YOUR_SCHWAB_APP_CALLBACK_URL
DATA_PROVIDER=schawb

# Agent access is disabled when no credentials are configured. Use unique random
# tokens of at least 32 characters. Keep this JSON in Secret Manager in production.
AGENT_CREDENTIALS_JSON=[]
# Optional local token alias for an MCP launcher. The stdio bridge reads MCP_AGENT_TOKEN.
MARKET_REGIME_AGENT_TOKEN=
# Simulation only. Restart the API after changing policy or credentials.
TRADING_POLICY_JSON={"version":"paper-v1","enabled":false,"allowedSymbols":["SPY"],"maxOrderDollars":1000,"maxDailyDollars":5000,"maxAnalysisAgeHours":96}

# Live BUY and SELL LIMIT DAY orders also require the trades:execute scope on an admin agent.
AGENT_LIVE_TRADING_ENABLED=false
# Set the USD limits here and configure SCHWAB_TRADE_ACCOUNT_HASH below before enabling.
AGENT_LIVE_TRADING_JSON={"maxOrderDollars":500,"maxDailyDollars":1000}

# Administrator Basic login (HTTPS only in production). Missing password disables admin access.
ADMIN_USERNAME=admin
# Set a random password of at least 32 characters through Secret Manager.
ADMIN_PASSWORD=

# Separate Accounts and Trading Production app credentials. Never copy market tokens here.
SCHWAB_TRADE_CLIENT_ID=
SCHWAB_TRADE_CLIENT_SECRET=
SCHWAB_TRADE_REDIRECT_URI=
SCHWAB_TRADE_ACCESS_TOKEN=
SCHWAB_TRADE_REFRESH_TOKEN=
# Cloud Run uses shared PostgreSQL token storage; unset retains local static-token behavior.
SCHWAB_TRADE_TOKEN_STORE=

# Scheduled paper agent. Disabled until explicitly configured; never submits broker orders.
PAPER_TRADING_JSON='{"enabled":false,"accountId":"paper-primary","strategy":"regime-allocation-v1","symbols":["SPY"],"benchmark":"SPY","initialCash":10000,"maxPositionWeight":0.2,"cashReserveWeight":0.2,"maxOrderDollars":1000,"maxDailyDollars":3000,"slippageBps":5,"feePerOrder":0,"maxSpreadBps":50,"maxQuoteAgeSeconds":60}'
# The scheduled agent uses a separate OpenAI API key; Codex login is not used.
OPENAI_API_KEY=
PAPER_AGENT_MODEL=

# Candidate generation only: active rules and skills are never auto-overwritten.
PAPER_REVIEW_JSON='{"enabled":false,"windowSessions":20,"minimumReturn":0,"maximumBenchmarkLag":0.02,"maximumDrawdown":0.05,"cooldownSessions":20}'

# Schwab account selector for live orders and calendar sync. Required for live trading
# or when multiple accounts are linked. Never expose this value publicly.
SCHWAB_TRADE_ACCOUNT_HASH=
