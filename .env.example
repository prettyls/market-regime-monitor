DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@ALLOYDB_PRIVATE_IP:5432/regime?schema=public&sslmode=require"
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CLIENT_ID=YOUR_DEVELOPER_CLIENT_ID
CLIENT_SECRET=YOUR_DEVELOPER_CLIENT_SECRETS
SCHWAB_ACCESS_TOKEN=YOUR_SCHWAB_ACCESS_TOKEN
SCHWAB_REFRESH_TOKEN=YOUR_SCHWAB_REFRESH_TOKEN
# Must exactly match the Callback URL on this app in the Schwab Developer Portal. Do not use http://localhost unless that exact value is registered there.
SCHWAB_REDIRECT_URI=YOUR_SCHWAB_APP_CALLBACK_URL
DATA_PROVIDER=schawb

# Agent access is disabled when no credentials are configured. Use unique random
# tokens of at least 32 characters. Keep this JSON in Secret Manager in production.
AGENT_CREDENTIALS_JSON=[]
# Simulation only. Restart the API after changing policy or credentials.
TRADING_POLICY_JSON={"version":"paper-v1","enabled":false,"allowedSymbols":["SPY"],"maxOrderDollars":1000,"maxDailyDollars":5000,"maxAnalysisAgeHours":96}

# Administrator Basic login (HTTPS only in production). Missing password disables admin access.
ADMIN_USERNAME=admin
# Set a random password of at least 32 characters through Secret Manager.
# ADMIN_PASSWORD=
