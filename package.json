{
  "name": "market-regime-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "npm run start:api",
    "start:api": "node dist/src/server.js",
    "collect": "tsx src/collect.ts",
    "backtest": "tsx src/backtest.ts",
    "cli": "tsx src/cli.ts",
    "schwab:oauth": "tsx scripts/schwab-oauth.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.3",
    "@prisma/client": "^6.16.2",
    "@sudowealth/schwab-api": "^2.1.1",
    "commander": "^14.0.1",
    "dotenv": "^18.0.5",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.0.1",
    "pino": "^9.11.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
