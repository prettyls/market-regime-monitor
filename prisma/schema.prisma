generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Instrument {
  id             String          @id @default(cuid())
  symbol         String          @unique
  name           String
  kind           InstrumentKind
  provider       String
  providerSymbol String
  active         Boolean         @default(true)
  config         Json
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bars           MarketBar[]
  analyses       Analysis[]
  alerts         Alert[]
}

model MarketBar {
  id           String     @id @default(cuid())
  instrumentId String
  timestamp    DateTime
  interval     String     @default("1d")
  open         Float
  high         Float
  low          Float
  close        Float
  volume       Float?
  source       String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, timestamp, interval])
  @@index([instrumentId, timestamp])
}

model Analysis {
  id           String     @id @default(cuid())
  instrumentId String
  timestamp    DateTime
  regime       String
  score        Float
  confidence   Float
  evidence     Json
  signals      Json
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, timestamp])
  @@index([instrumentId, timestamp])
}

model Alert {
  id           String        @id @default(cuid())
  instrumentId String
  timestamp    DateTime      @default(now())
  severity     AlertSeverity
  type         String
  title        String
  message      String
  fromRegime   String?
  toRegime     String
  score        Float
  confidence   Float
  evidence     Json
  dedupeKey    String        @unique
  instrument   Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([instrumentId, timestamp])
}

enum InstrumentKind {
  INDEX
  ETF
  EQUITY
  RATE
  COMMODITY
  OTHER
}

enum AlertSeverity {
  INFO
  WATCH
  WARNING
  CRITICAL
}

model TradeProposal {
  id             String   @id @default(cuid())
  agentId        String
  idempotencyKey String
  requestHash    String
  status         String
  symbol         String
  quantity       Int
  limitPrice     Decimal  @db.Decimal(18, 4)
  snapshot       Json
  policy         Json
  request        Json
  simulation     Json
  createdAt      DateTime @default(now())

  @@unique([agentId, idempotencyKey])
  @@index([createdAt])
}

model TradingAuditEvent {
  id         String   @id @default(cuid())
  agentId    String
  proposalId String
  event      String
  details    Json
  createdAt  DateTime @default(now())

  @@index([proposalId, createdAt])
}

model PaperAccount {
  id                  String   @id
  initialCash         Decimal  @db.Decimal(18, 4)
  cash                Decimal  @db.Decimal(18, 4)
  positions           Json
  benchmark           String
  benchmarkStartPrice Decimal? @db.Decimal(18, 4)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PaperRun {
  id        String   @id @default(cuid())
  accountId String
  session   String
  strategy  String
  status    String
  inputs    Json
  decision  Json
  execution Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, session, strategy])
  @@unique([accountId, session])
}

model PaperFill {
  id        String   @id @default(cuid())
  runId     String
  symbol    String
  side      String
  quantity  Int
  price     Decimal  @db.Decimal(18, 4)
  fee       Decimal  @db.Decimal(18, 4)
  createdAt DateTime @default(now())

  @@unique([runId, symbol])
}

model PaperReport {
  id        String   @id @default(cuid())
  accountId String
  session   String
  metrics   Json
  createdAt DateTime @default(now())

  @@unique([accountId, session])
}

model PaperRuleReview {
  id          String   @id @default(cuid())
  accountId   String
  session     String
  ruleVersion String
  status      String
  evidence    Json
  proposal    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, session, ruleVersion])
}
